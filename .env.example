# Django Debug Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-me-in-production

# Logging settings (options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# Database (SQLite default or PostgreSQL for Docker/Production)
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://nutriuser:nutripass@db:5432/nutridb
POSTGRES_DB=nutridb
POSTGRES_USER=nutriuser
POSTGRES_PASSWORD=nutripass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Static and media settings
STATIC_ROOT=/app/static
MEDIA_ROOT=/app/media

# Environment
ENVIRONMENT=development

# Security flags (uncomment in production)
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
